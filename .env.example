NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-deploy
SERVICE_TOKEN=replace-with-a-different-long-random-secret
MONGO_URL=mongodb://mongo:27017/workerin
REDIS_URL=redis://redis:6379
ELASTICSEARCH_URL=http://elasticsearch:9200
CASSANDRA_HOSTS=cassandra
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=workerin
MINIO_SECRET_KEY=workerin-local-secret
MINIO_BUCKET=workerin-media
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_URL=http://localhost:9000
API_PORT=3000
REALTIME_PORT=8081
GATEWAY_PORT=8080
WEB_PORT=4173
MAPS_PROVIDER=none
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:8080

# Hosted Supabase (create a project at https://supabase.com)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=workerin-media
AUTH_REDIRECT_URL=http://localhost:4173

# Mercado Pago Pro subscription (R$ 7/month); keep credentials server-side
APP_BASE_URL=https://your-workerin-domain.example
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
